# Copie para .env e ajuste os valores (não commite o .env real).

# --- Django ---
# Em produção (Render): False
DEBUG=True

# Gere uma chave segura: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=altere-esta-chave-secreta

# Hosts permitidos (separados por vírgula). No Render, RENDER_EXTERNAL_HOSTNAME é adicionado automaticamente.
# ALLOWED_HOSTS=meu-app.onrender.com

# Origens confiáveis para CSRF (separadas por vírgula, com https://).
# CSRF_TRUSTED_ORIGINS=https://meu-app.onrender.com

# --- Banco de dados (PostgreSQL) ---
# Local: postgres individual ou DATABASE_URL
# DB_NAME=finance_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Produção (Render + Neon): use endpoint *pooler* na connection string.
# Exemplo Neon pooler (Oregon): postgresql://usuario:senha@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
# Exemplo Neon pooler (us-east-1): postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Exemplo Neon direto: postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:senha@localhost:5432/finance_db

# --- Observabilidade (opcional) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
# ENABLE_SILK=False
# ENABLE_DEBUG_TOOLBAR=False
# ENABLE_PERF_MIDDLEWARE=False
# ENABLE_MINIFY_HTML=True
# ENABLE_DASHBOARD_AGG_CACHE=False
# REDIS_URL=redis://localhost:6379/0
# ENABLE_BENCHMARK_ROUTES=False
# REDIS_URL=redis://localhost:6379/0

# --- E-mail (reset de senha) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@seudominio.com
# PRIVACIDADE_EMAIL=privacidade@seudominio.com

# --- IA / Gemini (3 vars operacionais) ---
# ENABLE_CATEGORIZACAO_LLM=False
# GEMINI_API_KEY=
# CATEGORIZACAO_LLM_MODEL=gemini-2.5-flash-lite

# --- Storage S3/R2 (opcional — exports e fotos) ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Axes (rate limit login) ---
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME=1

# --- Superusuário inicial (deploy automático) ---
# DJANGO_SUPERUSER_USERNAME = nome completo (campo `nome` do modelo Usuario)
DJANGO_SUPERUSER_USERNAME=Admin Teste
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=altere-esta-senha-forte

# --- Gunicorn (opcional) ---
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_KEEPALIVE=5
# GUNICORN_LOG_LEVEL=info
