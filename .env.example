# Copie para .env e ajuste os valores (não commite o .env real).

# --- Django ---
DEBUG=True

# Gere uma chave segura: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=altere-esta-chave-secreta

# Produção (VPS): ENVIRONMENT=production, DEBUG=False
# ENVIRONMENT=production

# Hosts permitidos (separados por vírgula). Obrigatório em produção.
# ALLOWED_HOSTS=app.seudominio.com

# Origens confiáveis para CSRF (separadas por vírgula, com https://).
# CSRF_TRUSTED_ORIGINS=https://app.seudominio.com

# --- Banco de dados (PostgreSQL) ---
# Local: variáveis DB_* ou DATABASE_URL
# DB_NAME=finance_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Produção (VPS local): postgresql://financeiro:senha@127.0.0.1:5432/financeiro_prod
DATABASE_URL=postgresql://usuario:senha@localhost:5432/finance_db

# --- Redis / Celery (obrigatório em produção) ---
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# EXPORT_JOB_BACKEND=celery
# CATEGORIZACAO_JOB_BACKEND=celery

# --- Mídia (VPS: diretório persistente fora do git) ---
# MEDIA_ROOT=/var/lib/financeiro/media

# --- Observabilidade (opcional) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
# ENABLE_SILK=False
# ENABLE_DEBUG_TOOLBAR=False
# ENABLE_PERF_MIDDLEWARE=False
# ENABLE_MINIFY_HTML=True
# ENABLE_DASHBOARD_AGG_CACHE=False
# ENABLE_BENCHMARK_ROUTES=False

# --- E-mail (reset de senha) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@seudominio.com
# PRIVACIDADE_EMAIL=privacidade@seudominio.com

# --- IA / Gemini (3 vars operacionais) ---
# ENABLE_CATEGORIZACAO_LLM=False
# GEMINI_API_KEY=
# CATEGORIZACAO_LLM_MODEL=gemini-2.5-flash-lite

# --- Storage S3/R2 (opcional — exports e fotos) ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Axes (rate limit login) ---
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME=0.25

# --- Superusuário inicial (bootstrap manual na VPS) ---
# python manage.py criar_superusuario
# DJANGO_SUPERUSER_USERNAME=Admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=altere-esta-senha-forte

# --- Gunicorn (VPS: atrás do nginx) ---
# GUNICORN_BIND=127.0.0.1:8000
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_KEEPALIVE=5
# GUNICORN_LOG_LEVEL=info

# --- Backup (VPS — deploy/backup/backup.sh) ---
# BACKUP_DIR=/var/backups/financeiro
# BACKUP_GPG_PASSPHRASE_FILE=/var/backups/financeiro/.backup-pass
# BACKUP_RCLONE_REMOTE=b2:financeiro-backups
